for ax, (name, df) in zip(axes, sessions.items()):
    dg = df.dropna(subset=['lateral_acc', 'longitudinal_acc'])
    sc = ax.scatter(dg['lateral_acc'], dg['longitudinal_acc'],
                    c=dg.get('speed_kmh', pd.Series(dtype=float)),
                    cmap='plasma', s=1, alpha=0.4)
