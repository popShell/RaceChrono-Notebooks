def enrich(df):
    df = df.copy()

    # speed column is GPS speed in m/s; speed.1 is the calculated version
    if 'speed' in df.columns:
        df['speed_kmh'] = df['speed'] * 3.6

    # Per-lap cumulative distance
    # distance_traveled is session-cumulative, so subtract each lap's starting value
    if 'distance_traveled' in df.columns and 'lap_number' in df.columns:
        lapped = df['lap_number'].notna()
        lap_start = (
            df[lapped]
            .groupby('lap_number')['distance_traveled']
            .transform('min')
        )
        df.loc[lapped, 'cum_dist_m'] = df.loc[lapped, 'distance_traveled'] - lap_start

    return df


