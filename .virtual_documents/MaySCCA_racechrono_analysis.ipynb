CMP_SESSION = list(sessions.keys())[1]
lt_cmp    = all_lap_times[CMP_SESSION]
laps_cmp  = valid_laps(sessions[CMP_SESSION])

best_num  = int(lt_cmp.loc[lt_cmp['lap_time_s'].idxmin(), 'lap'])
best_lap  = laps_cmp[best_num].dropna(subset=['cum_dist_m', 'speed_kmh'])
max_dist  = best_lap['cum_dist_m'].max()
grid      = np.linspace(0, max_dist, 2000)
spd_best  = np.interp(grid, best_lap['cum_dist_m'], best_lap['speed_kmh'])

fig = make_subplots(rows=2, cols=1, shared_xaxes=True,
                    subplot_titles=[
                        f'Speed — Best (Lap {best_num}) vs all other laps',
                        'Speed delta (other - best)  |  green = best lap is faster'
                    ], vertical_spacing=0.1)

fig.add_trace(go.Scatter(x=grid, y=spd_best, name=f'Lap {best_num} (Best)',
                         line=dict(color='#00ff88', width=2.5)), row=1, col=1)

for i, (lap_num, lap) in enumerate(laps_cmp.items()):
    if lap_num == best_num:
        continue
    lc = lap.dropna(subset=['cum_dist_m', 'speed_kmh'])
    md = min(max_dist, lc['cum_dist_m'].max())
    g  = np.linspace(0, md, 2000)
    spd = np.interp(g, lc['cum_dist_m'], lc['speed_kmh'])
    best_at_g = np.interp(g, grid, spd_best)
    delta = spd - best_at_g   # positive = this lap is slower

    color = palette[i % len(palette)]
    fig.add_trace(go.Scatter(x=g, y=spd, name=f'Lap {lap_num}',
                             line=dict(color=color, width=1.2)), row=1, col=1)

    fig.add_trace(go.Scatter(
        x=g, y=np.where(delta >= 0, delta, np.nan),
        fill='tozeroy', showlegend=False,
        line=dict(width=0), fillcolor='rgba(0,255,136,0.2)'), row=2, col=1)
    fig.add_trace(go.Scatter(
        x=g, y=np.where(delta < 0, delta, np.nan),
        fill='tozeroy', showlegend=False,
        line=dict(width=0), fillcolor='rgba(255,80,80,0.2)'), row=2, col=1)

fig.add_hline(y=0, line_color='white', line_width=0.5, row=2, col=1)
fig.update_yaxes(title_text='Speed (km/h)', row=1, col=1)
fig.update_yaxes(title_text='Delta km/h', row=2, col=1)
fig.update_xaxes(title_text='Distance (m)', row=2, col=1)
fig.update_layout(template='plotly_dark', height=620,
                  title=f'Lap Comparison — {CMP_SESSION}', hovermode='x unified')
fig.show()





