def valid_laps(df, min_s=MIN_LAP_TIME_S):
    out = {}
    for lap_num, grp in df.dropna(subset=['lap_number']).groupby('lap_number'):
        t = grp['elapsed_time'].dropna()
        if (t.max() - t.min()) >= min_s:
            out[int(lap_num)] = grp.reset_index(drop=True)
    return out


