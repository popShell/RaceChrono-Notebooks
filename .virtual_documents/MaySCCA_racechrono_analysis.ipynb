# Minimum lap time in seconds to filter out partial / out-laps
MIN_LAP_TIME_S = 30.0





def load_racechrono_v3(filepath, label=None):
    filepath = Path(filepath)
    label = label or filepath.stem

    # Find the row containing the actual column names
    header_row_idx = None
    with open(filepath, 'r', encoding='utf-8-sig') as f:
        for i, line in enumerate(f):
            if 'timestamp' in line or 'lap_number' in line:
                header_row_idx = i
                break

    if header_row_idx is None:
        raise ValueError(f'Could not find header row in {filepath.name}')

    # Skip all metadata rows + the units row + the data-source row
    skip = list(range(header_row_idx)) + [header_row_idx + 1, header_row_idx + 2]

    df = pd.read_csv(filepath, skiprows=skip, encoding='utf-8-sig', low_memory=False)
    df.dropna(how='all', axis=1, inplace=True)
    df.dropna(how='all', axis=0, inplace=True)
    df.reset_index(drop=True, inplace=True)

    for col in df.columns:
        df[col] = pd.to_numeric(df[col], errors='coerce')

    df['session'] = label

    lap_list = sorted(df['lap_number'].dropna().unique().astype(int).tolist())
    print(f'  {label}: {len(df):,} rows | laps {lap_list} | '
          f'{df["lap_number"].isna().sum()} unlapped rows')
    return df


