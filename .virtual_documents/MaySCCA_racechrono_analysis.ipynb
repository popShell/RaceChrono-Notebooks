    ax.axvline(0, color='#555', lw=0.5)
    ax.set_xlabel('Lateral G  (+ = right)')
    ax.set_ylabel('Longitudinal G  (+ = accel)')
    ax.set_title(f'G-G — {name}')
    ax.set_aspect('equal')
    ax.grid(True, alpha=0.2)

