def get_lap_times(df, label=''):
    rows = []
    for lap_num, grp in df.dropna(subset=['lap_number']).groupby('lap_number'):
        t = grp['elapsed_time'].dropna()
        lap_t = t.max() - t.min()
        if lap_t >= MIN_LAP_TIME_S:
            rows.append({'lap': int(lap_num), 'lap_time_s': round(lap_t, 3)})
    lt = pd.DataFrame(rows).sort_values('lap').reset_index(drop=True)
    lt['lap_time_str'] = lt['lap_time_s'].apply(lambda s: f"{int(s//60)}:{s%60:05.2f}")
    lt['delta_s']     = (lt['lap_time_s'] - lt['lap_time_s'].min()).round(3)
    lt['delta_str']   = lt['delta_s'].apply(lambda s: 'BEST' if s == 0 else f'+{s:.3f}s')
    lt['session']     = label
    return lt


